{
  "framework": "astro",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "mediaplanningtool.com"
        }
      ],
      "destination": "https://www.mediaplanningtool.com/$1",
      "permanent": true
    },
    {
      "source": "/blog/2026-03-09-best-media-planning-tools-2026",
      "destination": "/blog/best-media-planning-tools-2026",
      "permanent": true
    },
    {
      "source": "/best-media-planning-tools",
      "destination": "/blog/best-media-planning-tools-2026",
      "permanent": false
    },
    {
      "source": "/mediatool",
      "destination": "/camphouse",
      "permanent": true
    },
    {
      "source": "/tools/mediatool",
      "destination": "/camphouse",
      "permanent": true
    },
    {
      "source": "/directory/mediatool",
      "destination": "/camphouse",
      "permanent": true
    }
  ]
}

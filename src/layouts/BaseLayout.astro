---
import "@fontsource-variable/inter";
import "@fontsource-variable/gabarito";
import themeConfig from "@util/themeConfig";
import "../styles/global.css";
import Posthog from "@components/analytics/Posthog.astro";
import Snitcher from "@components/analytics/Snitcher.astro";
import { ClientRouter } from "astro:transitions";
import { getOGImage } from "@util/getOGImage";

const { title, description, slug, faqSchema, noindex } = Astro.props;
const siteTitle = themeConfig.general.title;

const calculatedTitle = title || siteTitle;
const calculatedDescription = description || themeConfig.general.seo.description;

// Build canonical URL from the site base + the page slug.
// When slug is undefined (e.g., homepage), canonical is just the root URL.
const siteBase = themeConfig.general.seo.url.replace(/\/$/, "");
const normalizedSlug = slug ? `/${String(slug).replace(/^\/|\/$/g, "")}` : "";
const canonicalUrl = `${siteBase}${normalizedSlug}`;
const twitterDomain = siteBase.replace(/^https?:\/\//, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <title>{calculatedTitle}</title>
    <meta name="description" content={calculatedDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Facebook Meta Tags -->
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={calculatedTitle} />
    <meta property="og:description" content={calculatedDescription} />
    <meta property="og:image" content={getOGImage(slug)} />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={twitterDomain} />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={calculatedTitle} />
    <meta name="twitter:description" content={calculatedDescription} />
    <meta name="twitter:image" content={getOGImage(slug)} />
    <ClientRouter />
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
  </head>
  <body class="bg-white dark:bg-gray-900 text-gray-800 dark:text-gray-200">
    <slot />
    <Posthog />
    <Snitcher />
  </body>
</html>

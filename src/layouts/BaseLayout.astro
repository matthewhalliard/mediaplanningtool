---
import "@fontsource-variable/gabarito";
import themeConfig from "@util/themeConfig";
import "../styles/global.css";
import Posthog from "@components/analytics/Posthog.astro";
import { ClientRouter } from "astro:transitions";
import { getOGImage } from "@util/getOGImage";

const { title, description, slug, faqSchema } = Astro.props;
const siteTitle = themeConfig.general.title;

const calculatedTitle = title || siteTitle;
const calculatedDescription = description || themeConfig.general.seo.description;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="generator" content={Astro.generator} />

    <title>{calculatedTitle}</title>
    <meta name="description" content={calculatedDescription} />

    <!-- Facebook Meta Tags -->
    <meta property="og:url" content={themeConfig.general.seo.url} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={calculatedTitle} />
    <meta property="og:description" content={calculatedDescription} />
    <meta property="og:image" content={getOGImage(slug)} />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content="codeagents.dev" />
    <meta property="twitter:url" content={themeConfig.general.seo.url} />
    <meta name="twitter:title" content={calculatedTitle} />
    <meta name="twitter:description" content={calculatedDescription} />
    <meta name="twitter:image" content={getOGImage(slug)} />
    <ClientRouter />
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
  </head>
  <body class="bg-white dark:bg-gray-900">
    <slot />
    <Posthog />
  </body>
</html>

---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import themeConfig from "@util/themeConfig";
import "../styles/global.css";
import Posthog from "@components/analytics/Posthog.astro";
import Snitcher from "@components/analytics/Snitcher.astro";
import MetaPixel from "@components/analytics/MetaPixel.astro";
import { ClientRouter } from "astro:transitions";
import { getOGImage } from "@util/getOGImage";

const { title, description, slug, faqSchema, noindex } = Astro.props;
const siteTitle = themeConfig.general.title;

const calculatedTitle = title || siteTitle;
const calculatedDescription = description || themeConfig.general.seo.description;

// Build canonical URL from the site base + the page slug.
// When slug is undefined (e.g., homepage), canonical is just the root URL.
const siteBase = themeConfig.general.seo.url.replace(/\/$/, "");
const normalizedSlug = slug ? `/${String(slug).replace(/^\/|\/$/g, "")}` : "";
const canonicalUrl = `${siteBase}${normalizedSlug}`;
const twitterDomain = siteBase.replace(/^https?:\/\//, "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />

    <title>{calculatedTitle}</title>
    <meta name="description" content={calculatedDescription} />
    {noindex && <meta name="robots" content="noindex, follow" />}

    <!-- Facebook Meta Tags -->
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={calculatedTitle} />
    <meta property="og:description" content={calculatedDescription} />
    <meta property="og:image" content={getOGImage(slug)} />

    <!-- Twitter Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:domain" content={twitterDomain} />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={calculatedTitle} />
    <meta name="twitter:description" content={calculatedDescription} />
    <meta name="twitter:image" content={getOGImage(slug)} />
    <ClientRouter />
    <MetaPixel />
    {faqSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    )}
  </head>
  <body class="bg-gray-50 text-ink dark:bg-gray-900 dark:text-gray-200">
    <slot />
    <Posthog />
    <Snitcher />
    <script is:inline>
      // Record every click that leaves for Halliard, with the placement that
      // sent it (the link's utm_content). One listener for the whole site.
      if (!window.__halliardClickBound) {
        window.__halliardClickBound = true;
        document.addEventListener("click", function (e) {
          var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
          if (!a) return;
          var url;
          try { url = new URL(a.href); } catch (_) { return; }
          if (!/(^|\.)halliardmedia\.com$/.test(url.hostname)) return;
          var props = {
            placement: url.searchParams.get("utm_content") || "untagged",
            destination: url.pathname,
            page_path: window.location.pathname,
          };
          if (window.posthog && window.posthog.capture) window.posthog.capture("halliard_click", props);
          if (window.fbq) window.fbq("trackCustom", "HalliardClick", props);
        });
      }
    </script>
  </body>
</html>

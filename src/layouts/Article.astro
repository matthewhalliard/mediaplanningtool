---
import BaseLayout from "./BaseLayout.astro";
import AppProse from "../components/app/Prose.astro";
const { frontmatter, slug, mentionsHalliard } = Astro.props;
import OwnershipNote from "@components/app/OwnershipNote.astro";
import themeConfig from "@util/themeConfig";
import AppShell from "@components/app/AppShell.astro";
const siteTitle = themeConfig.general.title;
const title = frontmatter?.title || siteTitle;
const description = frontmatter?.description;
const pubDate = frontmatter?.pubDate;
const author = frontmatter?.author;
const readTime = frontmatter?.readTime;
const category = frontmatter?.category;

function formatDate(d: any): string | null {
  if (!d) return null;
  try {
    const dateObj = d instanceof Date ? d : new Date(d);
    if (isNaN(dateObj.getTime())) return null;
    return dateObj.toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    });
  } catch {
    return null;
  }
}

const formattedDate = formatDate(pubDate);
const hasMeta = formattedDate || author || readTime || category;
---

<BaseLayout title={title} description={description} slug={slug}>
  <AppShell>
    <article class="container-site max-w-[720px] pt-14 pb-20">
      {hasMeta && (
        <div class="not-prose mb-8 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-[13px] text-gray-600 dark:text-gray-400">
          {category && (
            <span class="mono-label inline-flex items-center gap-2 text-primary-600 dark:text-primary-300"><span class="h-2 w-2 rounded-full bg-primary-600" aria-hidden="true"></span>
              {category}
            </span>
          )}
          {formattedDate && (
            <span class="inline-flex items-center gap-1.5">
                            <time datetime={pubDate}>{formattedDate}</time>
            </span>
          )}
          {author && (
            <>
              <span aria-hidden="true" class="text-gray-300 dark:text-gray-600">·</span>
              <span class="inline-flex items-center gap-1.5">
                                {author}
              </span>
            </>
          )}
          {readTime && (
            <>
              <span aria-hidden="true" class="text-gray-300 dark:text-gray-600">·</span>
              <span class="inline-flex items-center gap-1.5">
                                {readTime}
              </span>
            </>
          )}
        </div>
      )}
      {mentionsHalliard && <OwnershipNote />}
      <AppProse>
        <slot />
      </AppProse>
    </article>
  </AppShell>
</BaseLayout>

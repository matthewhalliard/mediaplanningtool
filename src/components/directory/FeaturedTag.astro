---
import configData from "@util/themeConfig";

// The publisher's own product keeps its placement but says what it is.
const { label } = Astro.props;
---

<span
  class="absolute -top-3 ml-4 rounded-md border border-gray-200 bg-white px-2 py-0.5 text-xs font-medium text-gray-600 dark:border-gray-600 dark:bg-gray-800 dark:text-white"
>
  {label || configData.directoryUI.featured.labelForCard}
</span>

---
import DirectoryCard from "./cards/index.astro";
import config from "@util/themeConfig";

const { listings, id } = Astro.props;
const type = config.directoryUI.grid.type;
const grid = type == "rectangle-card-grid" || type == "small-card-grid";
const rows = type == "rows";
---

{
  rows ? (
    <div id={id} class="not-prose overflow-hidden rounded-[14px] border border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900">
      <div class="-mb-px">
        {Array.isArray(listings) && listings.map((e: any) => <DirectoryCard item={e} />)}
      </div>
    </div>
  ) : (
    <div
      id={id}
      class:list={[
        "not-prose grid grid-cols-1 gap-6",
        { "md:grid-cols-2 lg:grid-cols-3": grid },
      ]}
    >
      {Array.isArray(listings) && listings.map((e: any) => <DirectoryCard item={e} />)}
    </div>
  )
}

---
// Neutral homepage schema. Avoids a ranked ItemList that could make the
// independent directory look like a paid/self-serving leaderboard.

const collectionPageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Media Planning Tools Directory (2026)",
  "description": "An independent directory for comparing media planning tools by use case, team type, pricing transparency, planning workflow, and channel coverage.",
  "url": "https://www.mediaplanningtool.com",
  "isPartOf": {
    "@type": "WebSite",
    "name": "Media Planning Tools",
    "url": "https://www.mediaplanningtool.com"
  },
  "about": [
    { "@type": "Thing", "name": "Media planning software" },
    { "@type": "Thing", "name": "Media buying software" },
    { "@type": "Thing", "name": "Reach and frequency planning" },
    { "@type": "Thing", "name": "Media plan templates" }
  ],
  "hasPart": [
    {
      "@type": "WebPage",
      "name": "Free / lightweight media planning tools",
      "url": "https://www.mediaplanningtool.com/tools",
      "description": "Free and lightweight tools, calculators, and templates for individual planners and lean teams."
    },
    {
      "@type": "WebPage",
      "name": "Enterprise media planning suites",
      "url": "https://www.mediaplanningtool.com/basis",
      "description": "Enterprise planning and buying platforms for agencies and large teams."
    },
    {
      "@type": "WebPage",
      "name": "TV and cross-media reach tools",
      "url": "https://www.mediaplanningtool.com/nielsen-media-impact",
      "description": "Tools focused on TV, cross-media reach, frequency, and audience measurement."
    },
    {
      "@type": "WebPage",
      "name": "Agency workflow and flowchart tools",
      "url": "https://www.mediaplanningtool.com/bionic",
      "description": "Planning workflow, flowchart, and budget-management tools for agencies."
    }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "How should I choose a media planning tool?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Start with the planning job you need to do: reach and frequency modeling, budget allocation, agency workflow, media buying, audience research, or reporting. Then compare tools by channel coverage, pricing transparency, data sources, workflow fit, export options, and whether the platform is planning-only or includes buying."
      }
    },
    {
      "@type": "Question",
      "name": "Are these media planning tool rankings paid placements?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. MediaPlanningTool.com is maintained as an independent comparison directory. Tools are compared by use case, pricing transparency, workflow, channel coverage, and planning depth rather than paid placement."
      }
    },
    {
      "@type": "Question",
      "name": "Are any media planning tools free?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Some tools offer free or lightweight plans for individual planners, while enterprise platforms such as Basis, Mediaocean, Nielsen, and Strata are typically custom-priced. Free tools are usually strongest for planning, calculators, and early workflow; enterprise tools add procurement, integrations, buying, or proprietary data."
      }
    },
    {
      "@type": "Question",
      "name": "What does a media planning tool do?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A media planning tool helps marketers decide where to spend budget across channels such as TV, CTV, programmatic, paid social, search, audio, and OOH. Common features include audience definition, reach and frequency modeling, budget allocation, scenario comparison, flowcharts, and exports for buying or reporting."
      }
    },
    {
      "@type": "Question",
      "name": "Should I use Excel or dedicated media planning software?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Excel can work for simple single-channel plans. Dedicated media planning software becomes more useful when you need multi-channel reach and frequency math, audience overlap modeling, scenario comparison, cleaner approvals, or a repeatable planning workflow across multiple campaigns."
      }
    }
  ]
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Media Planning Tools",
  "alternateName": "MediaPlanningTool.com",
  "url": "https://www.mediaplanningtool.com",
  "description": "Independent directory and editorial guide to media planning tools and software in 2026.",
  "publisher": {
    "@type": "Organization",
    "name": "Media Planning Tools",
    "url": "https://www.mediaplanningtool.com"
  },
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://www.mediaplanningtool.com/?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(collectionPageSchema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

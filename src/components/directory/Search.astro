---
import { Icon } from "astro-icon/components";
import { getCollection } from "astro:content";
import formatString from "../../util/formatString";
import UiTagGrid from "../ui/tags/Grid.vue";
import UiTagSelect from "../ui/tags/Select.vue";
import config from "@util/themeConfig";
import type Tag from "../../types/Tag";

const listings = await getCollection("directory");
const searchPlaceholder = getSearchPlaceholder(listings.length);

function getSearchPlaceholder(count: number) {
  if (
    config.directoryData.search?.placeholder &&
    config.directoryData.search.placeholder.includes("{0}")
  ) {
    return formatString(
      config.directoryData.search?.placeholder ?? "Search among {0} listings",
      count,
    );
  }

  return config.directoryData.search?.placeholder ?? "Search";
}

// Quick filters: the most-used functional tags (user-type tags are grey in settings).
const counts: Record<string, number> = {};
for (const listing of listings) {
  for (const tag of (listing.data as any).tags ?? []) counts[tag] = (counts[tag] ?? 0) + 1;
}
const allTags = (config.directoryData.tags ?? []) as Tag[];
const pillKeys = allTags
  .filter((t) => t.color !== "gray" && t.key !== "featured" && (counts[t.key ?? ""] ?? 0) > 0)
  .sort((a, b) => (counts[b.key ?? ""] ?? 0) - (counts[a.key ?? ""] ?? 0))
  .slice(0, 6)
  .map((t) => t.key as string);
const display = config.directoryUI.search.tags.display;
---

<div class="not-prose container-site pb-14">
  <label class="flex h-[60px] max-w-[640px] items-center gap-3 rounded-[14px] border border-gray-300 bg-white pr-2.5 pl-5 transition-colors focus-within:border-ink dark:border-gray-600 dark:bg-gray-800">
    {
      config.directoryUI.search.icon && (
        <Icon
          name={config.directoryUI.search.icon}
          class="h-5 w-5 shrink-0 text-gray-500"
          aria-hidden="true"
        />
      )
    }
    <input
      id="search"
      type="search"
      aria-label="Search tools"
      class="min-w-0 flex-1 border-0 bg-transparent p-0 text-[17px] text-ink placeholder:text-gray-500 focus:ring-0 focus:outline-none dark:text-gray-100"
      placeholder={searchPlaceholder}
    />
    <kbd class="hidden sm:inline-flex items-center rounded-md border border-gray-200 px-2 py-1 font-mono text-xs text-gray-600 dark:border-gray-600 dark:text-gray-400">⌘K</kbd>
  </label>
  {
    () => {
      if (config.layout.sidebar) return <></>;
      if (display === "select") {
        return (
          <UiTagSelect client:load>
            <Icon name="tabler:x" />
          </UiTagSelect>
        );
      }
      if (display === "pills") {
        return <UiTagGrid client:load keys={pillKeys} counts={counts} />;
      }
      if (display === "show-all") {
        return <UiTagGrid client:load counts={counts} />;
      }
    }
  }
</div>

<script>
  import { search } from "../../store.js";

  const searchInput = document.getElementById("search");

  // Add an event listener to the button
  searchInput?.addEventListener("input", (event: Event) => {
    const target = event.target as HTMLSelectElement;
    search.set(target.value);
  });

  const keyListener = function (e: KeyboardEvent) {
    if (e.key === "k" && (e.ctrlKey || e.metaKey)) {
      e.preventDefault();
      searchInput?.focus();
    }

    if (e.key === "Escape") {
      e.preventDefault();
      searchInput?.blur();
    }
  };

  document.body.addEventListener("keydown", keyListener);
</script>

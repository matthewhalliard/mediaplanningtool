---
// Tool comparison table component for homepage
---

<div class="bg-white dark:bg-gray-900 py-12">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">
        Compare Top Media Planning Tools 2025
      </h2>
      <p class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Find the perfect media planning tool for your needs. Compare features, pricing, and capabilities of the industry's leading platforms.
      </p>
    </div>

    <div class="overflow-x-auto">
      <table class="min-w-full bg-white dark:bg-gray-800 rounded-lg shadow-lg">
        <thead class="bg-gray-50 dark:bg-gray-700">
          <tr>
            <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
              Tool
            </th>
            <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
              Category
            </th>
            <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
              Pricing
            </th>
            <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
              Key Features
            </th>
            <th class="px-6 py-4 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">
              Best For
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 dark:divide-gray-600">
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="text-sm font-medium text-gray-900 dark:text-white">
                  Adobe Advertising Cloud
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
              Enterprise DSP
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
              Enterprise
            </td>
            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-300">
              Adobe Integration, Advanced Targeting, Cross-Channel Management
            </td>
            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-300">
              Enterprise Brands, Agencies
            </td>
          </tr>
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="text-sm font-medium text-gray-900 dark:text-white">
                  GWI (Global Web Index)
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
              Consumer Research
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
              Enterprise
            </td>
            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-300">
              250K+ Profiling Points, AI Assistant, Global Data
            </td>
            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-300">
              Research Teams, Media Planners
            </td>
          </tr>
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="text-sm font-medium text-gray-900 dark:text-white">
                  The Trade Desk
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
              Independent DSP
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
              Enterprise
            </td>
            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-300">
              AI Optimization, Premium Inventory, Transparency
            </td>
            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-300">
              Media Agencies, Enterprise Brands
            </td>
          </tr>
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="text-sm font-medium text-gray-900 dark:text-white">
                  Mediaocean
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
              Media Planning Platform
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
              Enterprise
            </td>
            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-300">
              Workflow Management, Financial Planning, Campaign Tracking
            </td>
            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-300">
              Media Agencies, Large Teams
            </td>
          </tr>
          <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
            <td class="px-6 py-4 whitespace-nowrap">
              <div class="flex items-center">
                <div class="text-sm font-medium text-gray-900 dark:text-white">
                  Nielsen Media Impact
                </div>
              </div>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
              Media Planning & Analytics
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500 dark:text-gray-300">
              Enterprise
            </td>
            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-300">
              Cross-Platform Planning, Reach & Frequency, ROI Analysis
            </td>
            <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-300">
              Media Planners, Research Teams
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="mt-8 text-center">
      <a 
        href="/directory" 
        class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 transition-colors duration-200"
      >
        View All Tools
        <svg class="ml-2 -mr-1 w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
        </svg>
      </a>
    </div>
  </div>
</div>

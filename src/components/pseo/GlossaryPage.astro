---
import type { GlossaryPage } from "@lib/pseo/schemas";
import SharedCTA from "./SharedCTA.astro";

interface Props {
  data: GlossaryPage;
}

const { data } = Astro.props;
const { seo, term, content } = data;
---

<article class="max-w-4xl mx-auto">
  <!-- Breadcrumbs -->
  <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-6">
    <a href="/" class="hover:text-primary-600 transition-colors">Home</a>
    <span>/</span>
    <a href="/glossary" class="hover:text-primary-600 transition-colors">Glossary</a>
    <span>/</span>
    <span class="text-gray-700 dark:text-gray-300">{term.name}</span>
  </nav>

  <!-- Hero -->
  <div class="bg-gradient-to-br from-purple-50 to-indigo-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl p-8 mb-8">
    <div class="flex flex-wrap gap-2 mb-4">
      <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400">
        Glossary
      </span>
      {data.meta.category && (
        <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300">
          {data.meta.category}
        </span>
      )}
    </div>
    <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-gray-50 mb-4">
      {term.name}
    </h1>
    {term.abbreviation && (
      <p class="text-lg text-gray-500 dark:text-gray-400">
        Abbreviation: <span class="font-semibold">{term.abbreviation}</span>
      </p>
    )}
  </div>

  <!-- Definition -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 md:p-8 mb-6">
    <h2 class="text-xl font-bold text-gray-900 dark:text-gray-50 mb-3">Definition</h2>
    <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed font-medium">{term.definition}</p>
  </div>

  <!-- Extended Explanation -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 md:p-8 mb-6">
    <h2 class="text-xl font-bold text-gray-900 dark:text-gray-50 mb-3">In Detail</h2>
    <p class="text-gray-700 dark:text-gray-300 leading-relaxed">{term.extended_explanation}</p>
  </div>

  <!-- Example -->
  <div class="bg-blue-50 dark:bg-blue-900/10 border border-blue-200 dark:border-blue-800/30 rounded-xl p-6 md:p-8 mb-6">
    <h2 class="text-xl font-bold text-gray-900 dark:text-gray-50 mb-3 flex items-center gap-2">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-blue-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
      Example
    </h2>
    <p class="text-gray-700 dark:text-gray-300 leading-relaxed">{term.example}</p>
  </div>

  <!-- Why It Matters -->
  <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 md:p-8 mb-6">
    <h2 class="text-xl font-bold text-gray-900 dark:text-gray-50 mb-3">Why It Matters</h2>
    <p class="text-gray-700 dark:text-gray-300 leading-relaxed">{term.why_it_matters}</p>
  </div>

  <!-- Vertical Context -->
  {term.vertical_context && term.vertical_context.length > 0 && (
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 md:p-8 mb-6">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-50 mb-4">By Industry</h2>
      <div class="space-y-4">
        {term.vertical_context.map((vc) => (
          <div class="p-4 rounded-lg bg-gray-50 dark:bg-gray-750 border border-gray-100 dark:border-gray-700">
            <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-1">{vc.vertical}</h3>
            <p class="text-sm text-gray-600 dark:text-gray-400">{vc.note}</p>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- Related Terms -->
  {term.related_terms.length > 0 && (
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 md:p-8 mb-6">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-50 mb-4">Related Terms</h2>
      <div class="flex flex-wrap gap-3">
        {term.related_terms.map((rt) => (
          <a
            href={`/glossary/${rt.slug}`}
            class="inline-flex items-center px-4 py-2 rounded-lg text-sm font-medium bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 hover:bg-primary-50 dark:hover:bg-primary-900/20 hover:text-primary-700 dark:hover:text-primary-400 transition-colors"
          >
            {rt.name}
          </a>
        ))}
      </div>
    </div>
  )}

  <!-- FAQ -->
  {content.faq.length > 0 && (
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 md:p-8 mb-8">
      <h2 class="text-xl font-bold text-gray-900 dark:text-gray-50 mb-4">Frequently Asked Questions</h2>
      <div class="space-y-4">
        {content.faq.map((qa) => (
          <div class="border-b border-gray-100 dark:border-gray-700 pb-4 last:border-0 last:pb-0">
            <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">{qa.question}</h3>
            <p class="text-gray-600 dark:text-gray-400 leading-relaxed">{qa.answer}</p>
          </div>
        ))}
      </div>
    </div>
  )}

  <!-- CTA -->
  <SharedCTA text={content.cta.text} link={content.cta.link} contentType="glossary" />
</article>

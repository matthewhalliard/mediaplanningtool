---
interface Props {
  text: string;
  link: string;
  contentType?: string;
}

const { text, link, contentType } = Astro.props;

const ctaText = text || (() => {
  switch (contentType) {
    case 'checklist':
    case 'template':
    case 'guide':
    case 'framework':
    case 'calendar':
      return 'Find the right planning tools';
    case 'calculator':
    case 'estimator':
    case 'analyzer':
      return 'Explore measurement and analytics tools';
    default:
      return 'Explore more media planning tools';
  }
})();
---

<section class="mt-12 bg-gradient-to-br from-primary-50 to-blue-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl p-8 md:p-12 border border-primary-200 dark:border-gray-700">
  <div class="text-center max-w-2xl mx-auto">
    <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-gray-50 mb-4">
      {ctaText}
    </h2>
    <p class="text-gray-600 dark:text-gray-300 mb-6 text-lg">
      Compare features, pricing, and alternatives across 40+ media planning platforms.
    </p>
    <a
      href={link}
      class="inline-flex items-center justify-center gap-2 bg-primary-600 hover:bg-primary-700 text-white px-8 py-4 rounded-xl font-semibold text-lg transition-colors"
    >
      Browse All Tools
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
    </a>
  </div>
</section>

---
import AppLogo from "./Logo.astro";


const navigation = [
  {
    title: "Guides",
    links: [
      { title: "Complete Guide (2026)", link: "/guide" },
      { title: "Selection Guide", link: "/2026-guide" },
      { title: "All Resources", link: "/resources" },
      { title: "Blog", link: "/blog" },
    ],
  },
  {
    title: "Compare Tools",
    links: [
      { title: "Bionic vs. Halliard", link: "https://www.halliardmedia.com/compare/bionic?utm_source=mediaplanningtool&utm_medium=referral&utm_campaign=directory&utm_content=footer" },
      { title: "Mediaocean", link: "/mediaocean" },
      { title: "Camphouse", link: "/camphouse" },
      { title: "All 54 Tools", link: "/" },
    ],
  },
  {
    title: "Popular Tools",
    links: [
      { title: "Halliard", link: "/halliard" },
      { title: "Bionic", link: "/bionic" },
      { title: "Mediaocean", link: "/mediaocean" },
      { title: "The Trade Desk", link: "/the-trade-desk" },
    ],
  },
  {
    title: "Legal",
    links: [
      { title: "Privacy Policy", link: "/legal/privacy-policy" },
      { title: "Terms of Service", link: "/legal/terms-of-service" },
    ],
  },
];
---

<footer
  class="mt-24 border-t border-gray-200 bg-white dark:border-gray-700 dark:bg-gray-900"
  aria-labelledby="footer-heading"
>
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="container-site pt-14 pb-10">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.6fr)]">
      <div class="flex flex-col gap-5">
        <AppLogo />
        <p class="max-w-md text-sm leading-6 text-gray-600 dark:text-gray-400">
          <span class="font-medium text-ink dark:text-gray-100">Independence:</span>
          placements are not sold. One listed tool, Halliard, is made by this site's publisher and is marked as such.
          <a href="/about" class="underline underline-offset-2 hover:text-primary-600">About this directory</a>
        </p>
      </div>
      <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
        {
          navigation.map((group) => (
            <div>
              <h3 class="mono-label text-gray-500 dark:text-gray-400">{group.title}</h3>
              <ul role="list" class="mt-4 space-y-3">
                {group.links.map((item) => (
                  <li>
                    <a
                      href={item.link}
                      class="text-sm text-gray-600 hover:text-ink dark:text-gray-300 dark:hover:text-white"
                    >
                      {item.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
    <div class="mt-14 flex flex-wrap items-center justify-between gap-4 border-t border-gray-200 pt-6 text-sm text-gray-500 dark:border-gray-700">
      <p class="font-mono text-xs">&copy; {new Date().getFullYear()} mediaplanningtool.com</p>
      <div class="flex flex-wrap gap-5">
        <a href="/about" class="hover:text-ink">About</a>
        <a href="/2026-guide" class="hover:text-ink">How to choose</a>
        <a href="/legal/privacy-policy" class="hover:text-ink">Privacy</a>
        <a href="/legal/terms-of-service" class="hover:text-ink">Terms</a>
      </div>
    </div>
  </div>
</footer>

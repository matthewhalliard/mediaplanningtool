    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--color-gray-900);
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--color-gray-200);
  }
  .dark .prose th {
    color: var(--color-gray-100);

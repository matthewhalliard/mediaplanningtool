---
import { Icon } from "astro-icon/components";
import Logo from "./Logo.astro";
import config from "@util/themeConfig";

const isActive = (path: string, currentPath: string | undefined) => {
  if (!currentPath) return false;
  return (
    currentPath.split("/")[1] === path.split("/")[1] || currentPath === path
  );
};

const currentPath = new URL(Astro.request.url).pathname;
const links = config.header.navbar.links;
---

<header class="sticky top-0 z-40 border-b border-gray-200 bg-gray-50/90 backdrop-blur dark:border-gray-700 dark:bg-gray-900/90">
  <div class="container-site flex items-center gap-6 py-4">
    <Logo />

    <nav aria-label="Main" class="hidden md:flex flex-1 flex-wrap items-center gap-1">
      {
        links.map((navItem) => (
          <a
            href={navItem.href}
            target={navItem.target === "_blank" ? "_blank" : undefined}
            aria-current={isActive(navItem.href, currentPath) ? "page" : undefined}
            class:list={[
              "inline-flex items-center gap-1 rounded-lg px-3 py-2 text-sm transition-colors",
              isActive(navItem.href, currentPath)
                ? "bg-gray-100 text-ink dark:bg-gray-800 dark:text-white"
                : "text-gray-600 hover:text-ink hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800",
            ]}
          >
            {navItem.name}
            {navItem.target === "_blank" && <Icon name="tabler:arrow-up-right" class="w-3.5 h-3.5" />}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-2">
      {config?.header.actionButton?.text && (
        <a
          href={config.header.actionButton.href}
          class="hidden md:inline-flex h-10 items-center rounded-[10px] border border-gray-200 bg-white px-4 text-sm font-medium text-ink hover:border-ink dark:border-gray-700 dark:bg-gray-800 dark:text-white"
        >
          {config.header.actionButton.text}
        </a>
      )}
      <button
        id="mobile-menu-button"
        type="button"
        class="md:hidden inline-flex h-10 w-10 items-center justify-center rounded-[10px] border border-gray-200 bg-white text-ink dark:border-gray-700 dark:bg-gray-800 dark:text-white"
        aria-label="Open main menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
      >
        <Icon id="mobile-menu-icon" name="tabler:menu-2" class="h-5 w-5" aria-hidden="true" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="md:hidden hidden border-t border-gray-200 dark:border-gray-700">
    <nav aria-label="Main mobile" class="container-site flex flex-col gap-1 py-3">
      {
        links.map((item) => (
          <a
            href={item.href}
            target={item.target === "_blank" ? "_blank" : undefined}
            class:list={[
              "rounded-lg px-3 py-2.5 text-base",
              isActive(item.href, currentPath)
                ? "bg-gray-100 text-ink dark:bg-gray-800 dark:text-white"
                : "text-gray-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800",
            ]}
          >
            {item.name}
          </a>
        ))
      }
      {config?.header.actionButton?.text && (
        <a href={config.header.actionButton.href} class="mt-2 rounded-lg border border-gray-200 bg-white px-3 py-2.5 text-base font-medium text-ink">
          {config.header.actionButton.text}
        </a>
      )}
    </nav>
  </div>
</header>

<script>
  function bindMobileMenu() {
    const button = document.getElementById("mobile-menu-button");
    const menu = document.getElementById("mobile-menu");
    if (!button || !menu || button.dataset.bound) return;
    button.dataset.bound = "1";
    button.addEventListener("click", () => {
      const hidden = menu.classList.toggle("hidden");
      button.setAttribute("aria-expanded", hidden ? "false" : "true");
    });
  }
  bindMobileMenu();
  document.addEventListener("astro:page-load", bindMobileMenu);
</script>

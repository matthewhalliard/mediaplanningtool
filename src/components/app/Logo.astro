---
// Wordmark: a 2x2 rounded-square grid ("compare") in indigo, then the name in lowercase.
const { size = 26 } = Astro.props;
---

<a href="/" class="inline-flex items-center gap-2.5 no-underline text-ink dark:text-white" aria-label="mediaplanningtool home">
  <svg width={size} height={size} viewBox="0 0 28 28" aria-hidden="true" class="shrink-0">
    <rect width="28" height="28" rx="7" fill="#4338CA"></rect>
    <rect x="7" y="7" width="6" height="6" rx="1.5" fill="#FFFFFF"></rect>
    <rect x="15" y="7" width="6" height="6" rx="1.5" fill="#FFFFFF" opacity="0.55"></rect>
    <rect x="7" y="15" width="6" height="6" rx="1.5" fill="#FFFFFF" opacity="0.55"></rect>
    <rect x="15" y="15" width="6" height="6" rx="1.5" fill="#FFFFFF"></rect>
  </svg>
  <span class="text-[17px] font-semibold tracking-[-0.02em] whitespace-nowrap">mediaplanningtool</span>
</a>

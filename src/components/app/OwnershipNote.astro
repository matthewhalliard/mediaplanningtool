---
// Shown wherever this directory describes, compares or ranks Halliard.
interface Props {
  variant?: "listing" | "article";
}
const { variant = "article" } = Astro.props;
const text =
  variant === "listing"
    ? "Halliard publishes this directory, so this is a profile of our own product."
    : "Halliard publishes this directory. Where this article mentions or compares Halliard, read it knowing that.";
---

<aside class="not-prose mb-8 rounded-[12px] border border-gray-200 bg-white px-4 py-3 text-sm leading-6 text-gray-600 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
  <span class="mono-label mr-1.5 text-gray-500">Disclosure</span>
  {text}
  <a href="/about" class="underline underline-offset-2 hover:text-ink">About this directory</a>
</aside>

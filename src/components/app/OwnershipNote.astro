---
// Shown wherever this directory describes, compares or ranks Halliard.
interface Props {
  variant?: "listing" | "article";
}
const { variant = "article" } = Astro.props;
const text =
  variant === "listing"
    ? "Halliard publishes this directory, so this is a profile of our own product."
    : "Halliard publishes this directory. Where this article mentions or compares Halliard, read it knowing that.";
---

<aside class="not-prose mb-6 rounded-lg border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 px-4 py-3 text-sm text-gray-700 dark:text-gray-300">
  <strong class="font-semibold text-gray-900 dark:text-gray-100">Disclosure:</strong>
  {text}
  <a href="/about" class="underline hover:text-primary-700">About this directory</a>
</aside>

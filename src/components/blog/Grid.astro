---
import { getCollection } from "astro:content";

const allListings = await getCollection("blog");

function formatDate(d: any): string | null {
  if (!d) return null;
  try {
    const dateObj = d instanceof Date ? d : new Date(d);
    if (isNaN(dateObj.getTime())) return null;
    return dateObj.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    });
  } catch {
    return null;
  }
}

// Sort newest first by pubDate if available, otherwise keep original order
const sorted = [...allListings].sort((a: any, b: any) => {
  const da = a.data?.pubDate ? new Date(a.data.pubDate).getTime() : 0;
  const db = b.data?.pubDate ? new Date(b.data.pubDate).getTime() : 0;
  return db - da;
});
---

<div class="not-prose container-site grid grid-cols-1 gap-4 pt-4 md:grid-cols-2 lg:grid-cols-3">
  {sorted.map((entry: any) => {
    const title = entry.data?.title || entry.id;
    const excerpt = entry.data?.excerpt || entry.data?.description || "";
    const dateStr = formatDate(entry.data?.pubDate);
    const author = entry.data?.author;
    const readTime = entry.data?.readTime;
    const category = entry.data?.category;
    const href = `/blog/${entry.id}`;
    return (
      <a
        href={href}
        class="flex h-full flex-col rounded-[14px] border border-gray-200 bg-white p-6 transition-colors hover:border-ink dark:border-gray-700 dark:bg-gray-800 dark:hover:border-gray-300"
      >
        {(category || dateStr || readTime) && (
          <div class="mb-4 flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-xs text-gray-500 dark:text-gray-400">
            {category && (
              <span class="mono-label text-primary-600 dark:text-primary-300">
                {category}
              </span>
            )}
            {dateStr && (
              <span class="inline-flex items-center gap-1">
                {dateStr}
              </span>
            )}
            {readTime && (
              <>
                <span aria-hidden="true" class="text-gray-300 dark:text-gray-600">·</span>
                <span class="inline-flex items-center gap-1">
                  {readTime}
                </span>
              </>
            )}
          </div>
        )}
        <h3 class="m-0 mb-2 text-xl font-semibold leading-tight tracking-[-0.02em] text-ink dark:text-gray-100">
          {title}
        </h3>
        <p class="m-0 mb-4 line-clamp-3 text-[15px] leading-relaxed text-gray-600 dark:text-gray-300">
          {excerpt}
        </p>
        {author && (
          <div class="mt-auto inline-flex items-center gap-1.5 text-xs text-gray-500 dark:text-gray-400">
            {author}
          </div>
        )}
      </a>
    );
  })}
</div>

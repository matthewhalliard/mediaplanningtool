---
import { getCollection } from "astro:content";
import Wide from "@layouts/Wide.astro";
import Listing from "@layouts/Listing.astro";
import { render } from "astro:content";
import Sidebar from "@layouts/Sidebar.astro";
import Landing from "@layouts/Landing.astro";
import { getRootPages } from "@lib/getRootPages";
import { extractFAQs, generateFAQSchema } from "@util/extractFAQs";

export const prerender = true;

// Fetch all listings and pages
const { slug } = Astro.params;
const { entry } = Astro.props;

const { Content } = await render(entry);

export async function getStaticPaths() {
  return await getRootPages();
}

const landingView = slug === "blog";

// Extract FAQ structured data from markdown body for JSON-LD schema
const faqs = entry.body ? extractFAQs(entry.body) : [];
const faqSchema = generateFAQSchema(faqs);
---

{
  landingView ? (
    <Landing>
      <Content />
    </Landing>
  ) : (
    <Listing frontmatter={entry.data} slug={slug} faqSchema={faqSchema}>
      <Content />
    </Listing>
  )
}

---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import AppShell from "@components/app/AppShell.astro";
import CalculatorTool from "@components/pseo/CalculatorTool.vue";
import SharedCTA from "@components/pseo/SharedCTA.astro";
import { halliardUrl } from "@lib/halliard";
import { inlineMarkdownToHtml, stripInlineMarkdown, slugToTitle } from "@util/inlineMarkdown";
import type { FreeTool } from "@lib/pseo/schemas";

export const prerender = true;

export async function getStaticPaths() {
  const tools = await getCollection("pseoTools");
  // Templates have their own page in this folder (e.g. media-plan-template.astro).
  return tools.filter((entry) => (entry.data as FreeTool).meta.tool_type !== "template").map((entry) => {
    const data = entry.data as FreeTool;
    return {
      params: { slug: data.seo.slug },
      props: { entry: data },
    };
  });
}

const { entry } = Astro.props;
const data = entry as FreeTool;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: data.seo.title,
    description: data.seo.description,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: data.content.faq.map((qa) => ({
      "@type": "Question",
      name: qa.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: stripInlineMarkdown(qa.answer),
      },
    })),
  },
];
---

<BaseLayout title={data.seo.title} description={data.seo.description} slug={`tools/${data.seo.slug}`}>
  <AppShell>
    <div class="w-full px-4 py-8">
      <article class="max-w-4xl mx-auto">
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-6">
          <a href="/" class="hover:text-primary-600 transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-primary-600 transition-colors">Tools</a>
          <span>/</span>
          <span class="text-gray-700 dark:text-gray-300">{data.seo.title.replace(/ \|.*$/, '')}</span>
        </nav>

        <!-- Hero -->
        <div class="bg-white border border-gray-200 rounded-[14px] p-8 mb-8">
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400">
              Free Tool
            </span>
            <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300">
              {data.meta.tool_type}
            </span>
          </div>
          <h1 class="text-4xl md:text-5xl lg:text-[56px] font-semibold tracking-[-0.04em] leading-[1.02] text-gray-900 dark:text-gray-50 mb-4">
            {data.seo.title.replace(/ \|.*$/, '')}
          </h1>
          <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
            {data.seo.description}
          </p>
        </div>

        <!-- Quick answer: the direct answer to the search, above the tool -->
        {data.content.quick_answer && (
          <div class="rounded-xl border border-primary-200 bg-primary-50 dark:border-primary-800 dark:bg-primary-900/20 p-6 mb-8">
            <p class="text-sm font-medium uppercase tracking-wide text-primary-700 dark:text-primary-300 mb-2">Quick answer</p>
            <p class="text-lg text-gray-900 dark:text-gray-100 leading-relaxed" set:html={inlineMarkdownToHtml(data.content.quick_answer)} />
          </div>
        )}

        <!-- Calculator -->
        <CalculatorTool
          inputs={data.tool_config.inputs}
          formula={data.tool_config.formula}
          output={data.tool_config.output}
          presets={data.tool_config.presets}
          modes={data.tool_config.modes}
          client:load
        />

        <!-- Handoff: this calculator answers one number; the planning tool does the whole plan -->
        <p class="mt-4 mb-8 text-sm text-gray-600 dark:text-gray-400">
          This works out one number.
          <a href={halliardUrl("/plan", "calculator_inline")} class="font-semibold text-primary-700 dark:text-primary-300 underline">Model it across your whole plan in Halliard</a>,
          which publishes this directory.
        </p>

        <!-- Intro -->
        <div class="bg-white dark:bg-gray-800 rounded-xl p-6 md:p-8 border border-gray-200 dark:border-gray-700 mb-6">
          <p class="text-gray-700 dark:text-gray-300 text-lg leading-relaxed">{data.content.intro}</p>
        </div>

        <!-- How It Works -->
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 md:p-8 mb-6">
          <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-50 mb-3">How It Works</h2>
          <p class="text-gray-700 dark:text-gray-300 leading-relaxed" set:html={inlineMarkdownToHtml(data.content.how_it_works)} />
        </div>

        <!-- Benchmarks -->
        {data.content.benchmarks && (
          <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 md:p-8 mb-6">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-50 mb-4">{data.content.benchmarks.title}</h2>
            <div class="overflow-x-auto">
              <table class="w-full text-left text-sm">
                <thead>
                  <tr class="border-b border-gray-200 dark:border-gray-700">
                    <th scope="col" class="py-2 pr-4 font-semibold text-gray-900 dark:text-gray-100">{data.content.benchmarks.columns[0]}</th>
                    <th scope="col" class="py-2 font-semibold text-gray-900 dark:text-gray-100">{data.content.benchmarks.columns[1]}</th>
                  </tr>
                </thead>
                <tbody>
                  {data.content.benchmarks.rows.map(([a, b]) => (
                    <tr class="border-b border-gray-100 dark:border-gray-700 last:border-0">
                      <td class="py-2 pr-4 text-gray-700 dark:text-gray-300">{a}</td>
                      <td class="py-2 font-mono tabular-nums text-gray-900 dark:text-gray-100">{b}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            {data.content.benchmarks.note && (
              <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">{data.content.benchmarks.note}</p>
            )}
          </div>
        )}

        <!-- FAQ -->
        {data.content.faq.length > 0 && (
          <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 md:p-8 mb-6">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-50 mb-4">Frequently Asked Questions</h2>
            <div class="space-y-4">
              {data.content.faq.map((qa) => (
                <div class="border-b border-gray-100 dark:border-gray-700 pb-4 last:border-0 last:pb-0">
                  <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">{qa.question}</h3>
                  <p class="text-gray-600 dark:text-gray-400 leading-relaxed" set:html={inlineMarkdownToHtml(qa.answer)} />
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Related Tools -->
        {data.content.related_tools.length > 0 && (
          <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 md:p-8 mb-8">
            <h2 class="text-xl font-semibold text-gray-900 dark:text-gray-50 mb-4">Related Tools</h2>
            <div class="grid gap-4 md:grid-cols-2">
              {data.content.related_tools.map((tool) => (
                <a
                  href={`/${tool.slug}`}
                  class="block p-4 rounded-lg border border-gray-200 dark:border-gray-700 hover:border-ink dark:hover:border-ink hover:bg-gray-50 dark:hover:bg-gray-750 transition-colors"
                >
                  <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-1">{slugToTitle(tool.slug)}</h3>
                  <p class="text-sm text-gray-500 dark:text-gray-400">{tool.relevance}</p>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- CTA -->
        <SharedCTA text={data.content.cta.text} link={data.content.cta.link} contentType={data.meta.tool_type} />
      </article>
    </div>
  </AppShell>
  {jsonLd.map((ld) => (
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  ))}
</BaseLayout>

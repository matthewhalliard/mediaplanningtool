---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import AppShell from "@components/app/AppShell.astro";
import CalculatorTool from "@components/pseo/CalculatorTool.vue";
import SharedCTA from "@components/pseo/SharedCTA.astro";
import type { FreeTool } from "@lib/pseo/schemas";

export const prerender = true;

export async function getStaticPaths() {
  const tools = await getCollection("pseoTools");
  return tools.map((entry) => {
    const data = entry.data as FreeTool;
    return {
      params: { slug: data.seo.slug },
      props: { entry: data },
    };
  });
}

const { entry } = Astro.props;
const data = entry as FreeTool;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: data.seo.title,
    description: data.seo.description,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: data.content.faq.map((qa) => ({
      "@type": "Question",
      name: qa.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: qa.answer,
      },
    })),
  },
];
---

<BaseLayout title={data.seo.title} description={data.seo.description} slug={`tools/${data.seo.slug}`}>
  <AppShell>
    <div class="w-full px-4 py-8">
      <article class="max-w-4xl mx-auto">
        <!-- Breadcrumbs -->
        <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-6">
          <a href="/" class="hover:text-primary-600 transition-colors">Home</a>
          <span>/</span>
          <a href="/tools" class="hover:text-primary-600 transition-colors">Tools</a>
          <span>/</span>
          <span class="text-gray-700 dark:text-gray-300">{data.seo.title.replace(/ \|.*$/, '')}</span>
        </nav>

        <!-- Hero -->
        <div class="bg-gradient-to-br from-green-50 to-teal-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl p-8 mb-8">
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400">
              Free Tool
            </span>
            <span class="inline-flex items-center rounded-full px-3 py-1 text-xs font-medium bg-gray-100 text-gray-700 dark:bg-gray-700 dark:text-gray-300">
              {data.meta.tool_type}
            </span>
          </div>
          <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-gray-50 mb-4">
            {data.seo.title.replace(/ \|.*$/, '')}
          </h1>
          <p class="text-lg text-gray-600 dark:text-gray-300 leading-relaxed">
            {data.seo.description}
          </p>
        </div>

        <!-- Intro -->
        <div class="bg-white dark:bg-gray-800 rounded-xl p-6 md:p-8 border border-gray-200 dark:border-gray-700 mb-8">
          <p class="text-gray-700 dark:text-gray-300 text-lg leading-relaxed">{data.content.intro}</p>
        </div>

        <!-- Calculator -->
        <CalculatorTool
          inputs={data.tool_config.inputs}
          formula={data.tool_config.formula}
          output={data.tool_config.output}
          presets={data.tool_config.presets}
          client:load
        />

        <!-- How It Works -->
        <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 md:p-8 mb-6">
          <h2 class="text-xl font-bold text-gray-900 dark:text-gray-50 mb-3">How It Works</h2>
          <p class="text-gray-700 dark:text-gray-300 leading-relaxed">{data.content.how_it_works}</p>
        </div>

        <!-- FAQ -->
        {data.content.faq.length > 0 && (
          <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 md:p-8 mb-6">
            <h2 class="text-xl font-bold text-gray-900 dark:text-gray-50 mb-4">Frequently Asked Questions</h2>
            <div class="space-y-4">
              {data.content.faq.map((qa) => (
                <div class="border-b border-gray-100 dark:border-gray-700 pb-4 last:border-0 last:pb-0">
                  <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2">{qa.question}</h3>
                  <p class="text-gray-600 dark:text-gray-400 leading-relaxed">{qa.answer}</p>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Related Tools -->
        {data.content.related_tools.length > 0 && (
          <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 p-6 md:p-8 mb-8">
            <h2 class="text-xl font-bold text-gray-900 dark:text-gray-50 mb-4">Related Tools</h2>
            <div class="grid gap-4 md:grid-cols-2">
              {data.content.related_tools.map((tool) => (
                <a
                  href={`/${tool.slug}`}
                  class="block p-4 rounded-lg border border-gray-200 dark:border-gray-700 hover:border-primary-300 dark:hover:border-primary-700 hover:bg-gray-50 dark:hover:bg-gray-750 transition-colors"
                >
                  <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-1">{tool.slug.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())}</h3>
                  <p class="text-sm text-gray-500 dark:text-gray-400">{tool.relevance}</p>
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- CTA -->
        <SharedCTA text={data.content.cta.text} link={data.content.cta.link} contentType={data.meta.tool_type} />
      </article>
    </div>
  </AppShell>
  {jsonLd.map((ld) => (
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  ))}
</BaseLayout>

---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import AppShell from "@components/app/AppShell.astro";
import type { FreeTool } from "@lib/pseo/schemas";

export const prerender = true;

const tools = await getCollection("pseoTools");
const allTools = tools.map((entry) => entry.data as FreeTool);
allTools.sort((a, b) => a.seo.title.localeCompare(b.seo.title));

const toolTypeLabels: Record<string, { label: string; emoji: string }> = {
  calculator: { label: "Calculator", emoji: "🧮" },
  estimator: { label: "Estimator", emoji: "📊" },
  generator: { label: "Generator", emoji: "⚡" },
  analyzer: { label: "Analyzer", emoji: "🔍" },
  converter: { label: "Converter", emoji: "🔄" },
};
---

<BaseLayout title="Free Media Planning Tools — Calculators & Estimators" description="Free media planning calculators and tools. Calculate CPM, estimate reach, plan budgets, and more — built for media planners and buyers." slug="tools">
  <AppShell>
    <div class="w-full max-w-6xl mx-auto px-4 py-8">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-6">
        <a href="/" class="hover:text-primary-600 transition-colors">Home</a>
        <span>/</span>
        <span class="text-gray-700 dark:text-gray-300">Tools</span>
      </nav>

      <!-- Hero -->
      <div class="bg-gradient-to-br from-emerald-50 to-teal-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl p-8 md:p-12 mb-10">
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-gray-50 mb-4">
          Free Media Planning Tools
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl leading-relaxed">
          Interactive calculators and tools built for media planners. Estimate costs, plan budgets, and analyze performance — no signup required.
        </p>
      </div>

      <!-- Tools grid -->
      {allTools.length > 0 ? (
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 mb-12">
          {allTools.map((tool) => {
            const typeInfo = toolTypeLabels[tool.meta.tool_type];
            return (
              <a
                href={`/tools/${tool.seo.slug}`}
                class="group block rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 hover:border-primary-300 dark:hover:border-primary-600 hover:shadow-md transition-all"
              >
                <div class="flex items-center gap-2 mb-3">
                  <span class="text-2xl">{typeInfo?.emoji || "🛠️"}</span>
                  <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400">
                    {typeInfo?.label || tool.meta.tool_type}
                  </span>
                </div>
                <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-50 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors mb-2">
                  {tool.seo.title}
                </h3>
                <p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-2">
                  {tool.seo.description}
                </p>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="text-center py-16 text-gray-500 dark:text-gray-400">
          <p class="text-lg">More tools coming soon.</p>
        </div>
      )}

      <!-- CTA -->
      <section class="mt-8 bg-gradient-to-br from-primary-50 to-blue-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl p-8 md:p-12 border border-primary-200 dark:border-gray-700">
        <div class="text-center max-w-2xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-gray-50 mb-4">
            Measure what matters with Halliard
          </h2>
          <p class="text-gray-600 dark:text-gray-300 mb-6 text-lg">
            Go beyond calculators — plan, buy, and optimize media with a single platform.
          </p>
          <a
            href="https://halliardmedia.com/trytoday"
            class="inline-flex items-center justify-center gap-2 bg-primary-600 hover:bg-primary-700 text-white px-8 py-4 rounded-xl font-semibold text-lg transition-colors"
          >
            Get Started Free
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
        </div>
      </section>
    </div>
  </AppShell>
</BaseLayout>

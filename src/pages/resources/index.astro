---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import AppShell from "@components/app/AppShell.astro";
import type { ResourcePage } from "@lib/pseo/schemas";

export const prerender = true;

const resources = await getCollection("pseoResources");
const allData = resources.map((entry) => entry.data as ResourcePage);

// Group by content_type
const byType = new Map<string, ResourcePage[]>();
for (const page of allData) {
  const type = page.meta.content_type;
  if (!byType.has(type)) byType.set(type, []);
  byType.get(type)!.push(page);
}

// Sort each group alphabetically by title
for (const [, pages] of byType) {
  pages.sort((a, b) => a.seo.title.localeCompare(b.seo.title));
}

const contentTypeLabels: Record<string, { label: string; emoji: string; description: string }> = {
  checklist: { label: "Checklists", emoji: "✅", description: "Step-by-step checklists to plan and launch media campaigns" },
  guide: { label: "Guides", emoji: "📖", description: "In-depth guides covering channel strategies for specific verticals" },
  template: { label: "Templates", emoji: "📝", description: "Ready-to-use media brief and planning templates" },
  tips: { label: "Tips", emoji: "💡", description: "Expert tips for getting more from your media spend" },
  framework: { label: "Frameworks", emoji: "🏗️", description: "Strategic frameworks for building media plans" },
  best_practices: { label: "Best Practices", emoji: "⭐", description: "Proven best practices from top-performing campaigns" },
  calendar: { label: "Calendars", emoji: "📅", description: "Seasonal and campaign planning calendars" },
};

// Order types for display
const typeOrder = ["checklist", "guide", "template", "tips", "framework", "best_practices", "calendar"];
const sortedTypes = typeOrder.filter((t) => byType.has(t));

// Vertical label mapping
const verticalLabels: Record<string, string> = {
  automotive: "Automotive",
  cpg: "CPG",
  "financial-services": "Financial Services",
  healthcare: "Healthcare",
  retail: "Retail",
  travel: "Travel",
  technology: "Technology",
  entertainment: "Entertainment",
  qsr: "QSR",
};
---

<BaseLayout title="Media Planning Resources — Checklists, Guides & Templates" description="Free media planning resources for every vertical and channel. Download checklists, guides, templates, and frameworks built for media planners.">
  <AppShell>
    <div class="w-full max-w-6xl mx-auto px-4 py-8">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-6">
        <a href="/" class="hover:text-primary-600 transition-colors">Home</a>
        <span>/</span>
        <span class="text-gray-700 dark:text-gray-300">Resources</span>
      </nav>

      <!-- Hero -->
      <div class="bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl p-8 md:p-12 mb-10">
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-gray-50 mb-4">
          Media Planning Resources
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-300 max-w-3xl leading-relaxed">
          Free checklists, guides, templates, and frameworks for media planners. Every resource is tailored to a specific vertical and channel — built by practitioners, not generalists.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          {sortedTypes.map((type) => (
            <a
              href={`#${type}`}
              class="inline-flex items-center gap-1.5 rounded-full px-4 py-2 text-sm font-medium bg-white/80 dark:bg-gray-700 text-gray-700 dark:text-gray-200 hover:bg-white dark:hover:bg-gray-600 transition-colors border border-gray-200 dark:border-gray-600"
            >
              <span>{contentTypeLabels[type]?.emoji}</span>
              <span>{contentTypeLabels[type]?.label} ({byType.get(type)?.length})</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Sections by content type -->
      {sortedTypes.map((type) => {
        const typeInfo = contentTypeLabels[type];
        const pages = byType.get(type)!;
        return (
          <section id={type} class="mb-12">
            <div class="mb-6">
              <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-50 flex items-center gap-2">
                <span>{typeInfo?.emoji}</span>
                <span>{typeInfo?.label}</span>
                <span class="text-base font-normal text-gray-400">({pages.length})</span>
              </h2>
              <p class="text-gray-500 dark:text-gray-400 mt-1">{typeInfo?.description}</p>
            </div>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {pages.map((page) => (
                <a
                  href={`/resources/${page.seo.slug}`}
                  class="group block rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-5 hover:border-primary-300 dark:hover:border-primary-600 hover:shadow-md transition-all"
                >
                  <div class="flex flex-wrap gap-1.5 mb-3">
                    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-primary-100 text-primary-700 dark:bg-primary-900/30 dark:text-primary-400">
                      {verticalLabels[page.meta.vertical] || page.meta.vertical}
                    </span>
                    {page.meta.channel && (
                      <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium bg-gray-100 text-gray-600 dark:bg-gray-700 dark:text-gray-300">
                        {page.meta.channel.replace(/-/g, ' ')}
                      </span>
                    )}
                  </div>
                  <h3 class="text-base font-semibold text-gray-900 dark:text-gray-50 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors line-clamp-2 mb-2">
                    {page.seo.title.replace(/ \|.*$/, '')}
                  </h3>
                  <p class="text-sm text-gray-500 dark:text-gray-400 line-clamp-2">
                    {page.seo.description}
                  </p>
                </a>
              ))}
            </div>
          </section>
        );
      })}

      <!-- CTA -->
      <section class="mt-8 bg-gradient-to-br from-primary-50 to-blue-50 dark:from-gray-800 dark:to-gray-900 rounded-2xl p-8 md:p-12 border border-primary-200 dark:border-gray-700">
        <div class="text-center max-w-2xl mx-auto">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-gray-50 mb-4">
            Plan faster with Halliard
          </h2>
          <p class="text-gray-600 dark:text-gray-300 mb-6 text-lg">
            Compare tools, plan campaigns, and build media plans — all in one place.
          </p>
          <a
            href="https://halliardmedia.com/trytoday"
            class="inline-flex items-center justify-center gap-2 bg-primary-600 hover:bg-primary-700 text-white px-8 py-4 rounded-xl font-semibold text-lg transition-colors"
          >
            Get Started Free
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
        </div>
      </section>
    </div>
  </AppShell>
</BaseLayout>
